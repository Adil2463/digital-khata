{
    "name": "laravel-starter-kit",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "preinstall": "node ensure-node-env.js",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "test:unit": "vitest run",
        "format": "prettier --write --cache --cache-strategy content .",
        "format:check": "prettier --check --cache --cache-strategy content .",
        "lint": "eslint . --fix --max-warnings=0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
        "lint:check": "eslint . --max-warnings=0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
        "cleanup": "npm run format && npm run lint && npm run typecheck"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify/json": "^2.2.542",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@types/node": "^26.6.5",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "jsdom": "^30.1.2",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
        "typescript-eslint": "^8.71.2",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-icons": "^24.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vitest": "^5.0.4",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@inertiajs/vite": "^3.9.1",
        "@inertiajs/vue3": "^3.9.1",
        "@laravel/echo-vue": "^2.6.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vueuse/core": "^15.0.0",
        "clsx": "^2.1.1",
        "fontaine": "^0.8.2",
        "laravel-echo": "^2.6.1",
        "laravel-vite-plugin": "^3.2.0",
        "pinia": "^4.0.3",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vite": "^8.3.4",
        "vue": "^3.5.44"
    },
    "overrides": {
        "typescript": "$typescript"
    },
    "optionalDependencies": {
        "@rolldown/binding-linux-x64-gnu": "1.2.13",
        "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
        "lightningcss-linux-x64-gnu": "1.33.0"
    },
    "engines": {
        "node": ">=24.15.0",
        "npm": ">=11.2.1"
    },
    "allowScripts": {}
}
