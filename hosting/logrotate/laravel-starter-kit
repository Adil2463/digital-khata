# Install as /etc/logrotate.d/laravel-starter-kit. See docs/deployment.md.
/srv/laravel-starter-kit/hosting/nginx_logs/*.log {
    # The deploy user owns the checkout, which logrotate otherwise refuses to rotate in.
    su root root
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ ! -f /run/nginx.pid ] || kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
